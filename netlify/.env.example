# Configure in Netlify UI, Functions scope; never use VITE_ names for secrets.
V3_HOSTING_ENABLED=true
V3_SITE_ORIGIN=https://YOUR-SITE.netlify.app
V3_ACCESS_TOKEN=REPLACE_WITH_RANDOM_SECRET_64_HEXADECIMAL_CHARACTERS
V3_SESSION_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET_64_HEXADECIMAL_CHARACTERS
V3_WORKER_TOKEN=REPLACE_WITH_THIRD_RANDOM_SECRET_64_HEXADECIMAL_CHARACTERS
V3_OPERATOR_CONTACT=you@example.com
V3_FOSSGIS_POLICY_REVIEWED=true
V3_EARLY_NO_TOLLS=false
# Blobs credentials/context are supplied by Netlify. CONTEXT is not assumed available at runtime.
